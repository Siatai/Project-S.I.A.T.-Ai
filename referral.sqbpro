ql><sql name="SQL 1*">INSERT INTO users (
    name,
    email,
    email_lower,
    is_associate,
    pending_associate,
    is_admin,
    referral_code,
    referred_by,
    registered_at,
    wallet,
    wallet_balance
) VALUES (
    'Super Admin',                       -- name
    'saad.apoorti@gmail.com',            -- email
    LOWER('saad.apoorti@gmail.com'),     -- email_lower
    0,                                   -- is_associate
    0,                                   -- pending_associate
    1,                                   -- is_admin ✅
    'ADMIN' || CAST(STRFTIME('%s','now') AS TEXT), -- unique referral_code
    NULL,                                -- referred_by
    CURRENT_TIMESTAMP,                   -- registered_at
    NULL,                                -- wallet
    0                                    -- wallet_balance
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
